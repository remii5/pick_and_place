<?xml version="1.0" ?>
<sdf version="1.9">
  <model name = "red_cube">
    <link name="link">
      <visual name = "visual">
        <geometry>
          <box> 
            <size> 0.03 0.03 0.03 </size>
          </box>
        </geometry>
        <material >
          <ambient>0.75 0.0 0 1</ambient>
          <diffuse>1.0 0.0 0 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
          <emissive>0.1 0 0 1</emissive>
        </material>
      </visual>
      <collision name = "collision">
        <geometry>
          <box> 
            <size> 0.03 0.03 0.03 </size>
          </box>
        </geometry>
      </collision>
      <!-- I = (1/6) · m · s² -->
      <inertial name = "inertial">
        <mass>.02</mass>
        <pose>0 0 0 0 0 0</pose>
        <inertia>
          <ixx>3e-6</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>3e-6</iyy>
          <iyz>0</iyz>
          <izz>3e-6</izz>
        </inertia>
      </inertial>
    </link>

  </model>
</sdf>
