<?xml version="1.0" encoding="utf-8" ?>
<robot name = "camera" xmlns:xacro="http://ros.org/wiki/xacro">
  
  <material name="red">
    <color rgba="1.0 0.0 0.0 1.0"/>
  </material>

  <!--ONLY dimensions, weight, and inertia match the values of a orbbec femto bolt camera. Sensor specs are custom-->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.04026 0.1153 0.06495"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.04026 0.1153 0.06495"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.348"/>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <inertia ixx="5.08e-4" ixy="0.0" ixz="0.0" iyy="1.69e-4" iyz="0.0" izz="4.33e-4"/>
    </inertial>
  </link>

  <joint name = "camera_optical_joint" type = "fixed">
    <parent link = "camera_link"/>
    <child link = "camera_optical_link"/>
    <origin xyz = "0.0 0.0 0.0" rpy = "${-pi/2} 0.0 ${-pi/2}"/>
  </joint>

  <link name = "camera_optical_link"></link>

  <gazebo>
    <static>true</static>
  </gazebo>

  <gazebo reference = "camera_link">
    <material>Gazebo/Red</material>

    <sensor name="camera" type="rgbd_camera">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <topic>camera</topic>
      <gz_frame_id>camera_optical_link</gz_frame_id>
      <camera>
        <horizontal_fov>1.089</horizontal_fov>
        <image>
          <format>R8G8B8</format>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.05</near>
          <far>8.0</far>
        </clip>
      </camera>
    </sensor>
    
  </gazebo>
</robot>
